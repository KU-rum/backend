#!/bin/sh

# 커밋 메시지 규칙: 제목은 50자 이하, 접두사(feat: 등) 필수, 이슈 번호(#숫자) 필수
echo "commit-msg hook 실행됨"

commit_message=$(cat "$1")

echo "commit rule applied"

# 현재 브랜치 이름 가져오기
branch_name=$(git symbolic-ref --short HEAD)

# 브랜치 이름에서 이슈 번호 추출 (#숫자 형식)
issue_number=$(echo "$branch_name" | grep -o '#[0-9]\+')

# 이슈 번호가 있고, 아직 커밋 메시지에 포함되어 있지 않으면 추가
if [ -n "$issue_number" ] && ! echo "$commit_message" | grep -q "$issue_number"; then
  # 커밋 메시지 끝에 이슈 번호 추가
  commit_message=$(echo "$commit_message" | sed "s/$/ ($issue_number)/")
  echo "$commit_message" > "$1"
  echo "이슈 번호 '$issue_number'가 커밋 메시지에 자동으로 추가 되었습니다."
fi

# 형식 검증: 접두사(feat:, fix: 등) 포함 + 이슈 번호(#숫자) 포함 + 50자 이하
if ! echo "$commit_message" | grep -Eq '^(bug|feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert|bug|merge|Merge): .+\(#[0-9]+\)$' || [ ${#commit_message} -gt 50 ]; then
  echo "커밋 메시지는 'feat:', 'fix:' 등으로 시작하고, 50자 이하여야 하며, 이슈 번호(#숫자)를 포함해야 합니다."
  echo "예시: feat: 로그인 기능 추가(#123)"
  exit 1
else
  echo "✅ 커밋 메시지 형식이 올바릅니다: '$commit_message'"
fi